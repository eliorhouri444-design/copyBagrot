{
  "name": "TutorSettings",
  "type": "object",
  "properties": {
    "setting_key": {
      "type": "string",
      "enum": [
        "global_instructions"
      ],
      "description": "\u05de\u05e4\u05ea\u05d7 \u05d4\u05d4\u05d2\u05d3\u05e8\u05d4"
    },
    "instructions": {
      "type": "string",
      "description": "\u05d4\u05d4\u05d5\u05e8\u05d0\u05d5\u05ea \u05d4\u05d2\u05dc\u05d5\u05d1\u05dc\u05d9\u05d5\u05ea \u05dc\u05de\u05d5\u05e8\u05d4 \u05d4\u05d7\u05db\u05dd - \u05d0\u05d9\u05da \u05dc\u05e2\u05e0\u05d5\u05ea \u05d5\u05dc\u05d4\u05e1\u05d1\u05d9\u05e8 \u05dc\u05db\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05d4\u05d5\u05e8\u05d0\u05d5\u05ea \u05e4\u05e2\u05d9\u05dc\u05d5\u05ea"
    },
    "last_updated_by": {
      "type": "string",
      "description": "\u05de\u05d9 \u05e2\u05d3\u05db\u05df \u05dc\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4"
    }
  },
  "required": [
    "setting_key",
    "instructions"
  ],
  "rls": {
    "read": {},
