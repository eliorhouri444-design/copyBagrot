      "description": "\u05e8\u05de\u05ea \u05e7\u05d5\u05e9\u05d9 1-5"
    },
    "cefr_level": {
      "type": "string",
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "C1",
        "C2"
      ],
      "description": "\u05e8\u05de\u05ea \u05e7\u05d5\u05e9\u05d9 \u05dc\u05e4\u05d9 CEFR"
    },
    "synonyms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05d9\u05dc\u05d9\u05dd \u05e0\u05e8\u05d3\u05e4\u05d5\u05ea \u05d1\u05d0\u05e0\u05d2\u05dc\u05d9\u05ea"
    },
    "antonyms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05d9\u05dc\u05d9\u05dd \u05d4\u05e4\u05d5\u05db\u05d5\u05ea \u05d1\u05d0\u05e0\u05d2\u05dc\u05d9\u05ea"
    },
