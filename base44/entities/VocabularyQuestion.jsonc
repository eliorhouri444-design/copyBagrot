{
  "name": "VocabularyQuestion",
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string",
      "description": "\u05d4\u05de\u05e7\u05e6\u05d5\u05e2 (\u05d0\u05e0\u05d2\u05dc\u05d9\u05ea)"
    },
    "unit_level": {
      "type": "integer",
      "description": "\u05e8\u05de\u05ea \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea"
    },
