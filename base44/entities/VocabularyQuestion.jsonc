    "image_url": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05ea\u05de\u05d5\u05e0\u05d4 \u05d4\u05de\u05de\u05d7\u05d9\u05e9\u05d4 \u05d0\u05ea \u05d4\u05de\u05d9\u05dc\u05d4"
    },
