        "auto_generate_sentences": {
          "type": "boolean",
          "default": true,
          "description": "\u05d4\u05d0\u05dd \u05dc\u05d9\u05d9\u05e6\u05e8 \u05de\u05e9\u05e4\u05d8\u05d9 \u05d3\u05d5\u05d2\u05de\u05d4 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea"
        },
        "auto_generate_synonyms": {
          "type": "boolean",
          "default": false,
          "description": "\u05d4\u05d0\u05dd \u05dc\u05d9\u05d9\u05e6\u05e8 \u05e0\u05e8\u05d3\u05e4\u05d5\u05ea \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "description": "\u05de\u05ea\u05d9 \u05e0\u05d5\u05e6\u05e8 \u05ea\u05d5\u05db\u05df AI \u05dc\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4"
        },
        "generation_model": {
          "type": "string",
          "description": "\u05d0\u05d9\u05d6\u05d4 \u05de\u05d5\u05d3\u05dc AI \u05e9\u05d9\u05de\u05e9"
        }
      },
      "description": "\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05d9\u05e6\u05d9\u05e8\u05ea \u05ea\u05d5\u05db\u05df AI"
    },
    "usage_stats": {
      "type": "object",
