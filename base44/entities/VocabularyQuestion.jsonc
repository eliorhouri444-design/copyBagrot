          "type": "number",
          "description": "\u05d3\u05d9\u05e8\u05d5\u05d2 \u05e7\u05d5\u05e9\u05d9 \u05de\u05d7\u05d5\u05e9\u05d1 0-1"
        }
      },
      "description": "\u05e1\u05d8\u05d8\u05d9\u05e1\u05d8\u05d9\u05e7\u05d5\u05ea \u05e9\u05d9\u05de\u05d5\u05e9 \u05d2\u05dc\u05d5\u05d1\u05dc\u05d9\u05d5\u05ea"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05ea\u05d2\u05d9\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea (bagrut, academic, daily, etc.)"
