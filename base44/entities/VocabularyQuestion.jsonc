      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e0\u05d5\u05e9\u05d0 (\u05de\u05e7\u05d5\u05e9\u05e8 \u05dc-TopicNew)"
    },
    "category": {
      "type": "string",
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 (Basic Verbs, Academic Vocabulary, Connectors, \u05d5\u05db\u05d5')"
    },
    "hebrew_word": {
      "type": "string",
      "description": "\u05d4\u05de\u05d9\u05dc\u05d4 \u05d1\u05e2\u05d1\u05e8\u05d9\u05ea"
    },
    "english_answer": {
      "type": "string",
      "description": "\u05d4\u05ea\u05e9\u05d5\u05d1\u05d4 \u05d4\u05e0\u05db\u05d5\u05e0\u05d4 \u05d1\u05d0\u05e0\u05d2\u05dc\u05d9\u05ea"
    },
    "acceptable_answers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05ea\u05e9\u05d5\u05d1\u05d5\u05ea \u05de\u05e7\u05d5\u05d1\u05dc\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea"
    },
    "example_sentence": {
      "type": "string",
      "description": "\u05de\u05e9\u05e4\u05d8 \u05dc\u05d3\u05d5\u05d2\u05de\u05d4 \u05d1\u05d0\u05e0\u05d2\u05dc\u05d9\u05ea"
    },
    "example_sentence_he": {
      "type": "string",
