          "description": "\u05e1\u05d5\u05d2\u05d9 \u05e9\u05d0\u05dc\u05d5\u05ea \u05de\u05d5\u05ea\u05e8\u05d9\u05dd"
        },
        "custom_distractors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "\u05de\u05e1\u05d9\u05d7\u05d9\u05dd \u05de\u05d5\u05ea\u05d0\u05de\u05d9\u05dd \u05d0\u05d9\u05e9\u05d9\u05ea"
        },
        "context_question": {
          "type": "string",
          "description": "\u05e9\u05d0\u05dc\u05ea \u05d4\u05e7\u05e9\u05e8 \u05de\u05d5\u05ea\u05d0\u05de\u05ea"
        },
        "fill_blank_sentence": {
          "type": "string",
          "description": "\u05de\u05e9\u05e4\u05d8 \u05dc\u05d4\u05e9\u05dc\u05de\u05ea \u05de\u05d9\u05dc\u05d4 \u05e2\u05dd ___ \u05d1\u05de\u05e7\u05d5\u05dd \u05d4\u05de\u05d9\u05dc\u05d4"
        }
      },
      "description": "\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05d1\u05d5\u05d7\u05df \u05de\u05ea\u05e7\u05d3\u05dd"
    },
    "ai_generation": {
      "type": "object",
      "properties": {
        "auto_generate_distractors": {
          "type": "boolean",
          "default": true,
          "description": "\u05d4\u05d0\u05dd \u05dc\u05d9\u05d9\u05e6\u05e8 \u05de\u05e1\u05d9\u05d7\u05d9\u05dd \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea"
