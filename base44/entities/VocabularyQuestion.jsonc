        },
        "show_phonetic": {
          "type": "boolean",
          "default": true
        },
        "auto_play_audio": {
          "type": "boolean",
          "default": false
        }
      },
      "description": "\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05ea\u05e6\u05d5\u05d2\u05ea Flashcard"
