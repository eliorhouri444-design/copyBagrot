        "hebrew_audio_url": {
          "type": "string",
          "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05d0\u05d5\u05d3\u05d9\u05d5 \u05d1\u05e2\u05d1\u05e8\u05d9\u05ea"
        }
      },
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8\u05d9 \u05d0\u05d5\u05d3\u05d9\u05d5"
