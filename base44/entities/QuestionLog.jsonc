{
  "name": "QuestionLog",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "description": "\u05d4\u05e9\u05d0\u05dc\u05d4 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9\u05ea"
    },
    "subject": {
      "type": "string",
      "description": "\u05d4\u05de\u05e7\u05e6\u05d5\u05e2 \u05e9\u05d6\u05d5\u05d4\u05d4"
    },
    "topic": {
      "type": "string",
      "description": "\u05d4\u05e0\u05d5\u05e9\u05d0 \u05e9\u05d6\u05d5\u05d4\u05d4"
    },
    "answer": {
      "type": "string",
      "description": "\u05d4\u05ea\u05e9\u05d5\u05d1\u05d4 \u05d4\u05de\u05dc\u05d0\u05d4"
    },
    "has_latex": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d9\u05e9 LaTeX"
    },
    "has_graph": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d9\u05e9 \u05d2\u05e8\u05e3"
    },
    "retrieved_sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05e7\u05d5\u05e8\u05d5\u05ea \u05e9\u05e0\u05de\u05e6\u05d0\u05d5"
    },
    "quality_score": {
      "type": "number",
      "description": "\u05e6\u05d9\u05d5\u05df \u05d0\u05d9\u05db\u05d5\u05ea (0-1)"
    },
    "user_feedback": {
      "type": "string",
      "enum": [
        "helpful",
        "not_helpful",
        "partially_helpful"
      ],
      "description": "\u05de\u05e9\u05d5\u05d1 \u05de\u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "processing_time_ms": {
      "type": "integer",
      "description": "\u05d6\u05de\u05df \u05e2\u05d9\u05d1\u05d5\u05d3 \u05d1\u05de\u05d9\u05dc\u05d9\u05e9\u05e0\u05d9\u05d5\u05ea"
    },
    "model_used": {
      "type": "string",
      "description": "\u05d4\u05de\u05d5\u05d3\u05dc \u05e9\u05e9\u05d9\u05de\u05e9"
    }
  },
  "required": [
    "question",
    "answer"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}