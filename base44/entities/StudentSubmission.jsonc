{
  "name": "StudentSubmission",
  "type": "object",
  "properties": {
    "question_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e9\u05d0\u05dc\u05d4"
    },
    "student_answer": {
      "type": "string",
      "description": "\u05ea\u05e9\u05d5\u05d1\u05ea \u05d4\u05ea\u05dc\u05de\u05d9\u05d3"
    },
    "subject": {
      "type": "string",
      "description": "\u05d4\u05de\u05e7\u05e6\u05d5\u05e2"
    },
    "checking_result": {
      "type": "object",
      "description": "\u05ea\u05d5\u05e6\u05d0\u05d5\u05ea \u05d4\u05d1\u05d3\u05d9\u05e7\u05d4"
    },
    "score": {
      "type": "number",
      "description": "\u05e6\u05d9\u05d5\u05df 0-100"
    },
    "percentage": {
      "type": "number",
      "description": "\u05d0\u05d7\u05d5\u05d6\u05d9\u05dd"
    },
    "is_correct": {
      "type": "boolean",
      "description": "\u05d4\u05d0\u05dd \u05d4\u05ea\u05e9\u05d5\u05d1\u05d4 \u05e0\u05db\u05d5\u05e0\u05d4"
    },
    "errors_found": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "\u05d8\u05e2\u05d5\u05d9\u05d5\u05ea \u05e9\u05d6\u05d5\u05d4\u05d5"
    },
    "time_spent": {
      "type": "integer",
      "description": "\u05d6\u05de\u05df \u05e9\u05d4\u05d5\u05e9\u05e7\u05e2 \u05d1\u05d3\u05e7\u05d5\u05ea"
    },
    "attempt_number": {
      "type": "integer",
      "default": 1,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e0\u05d9\u05e1\u05d9\u05d5\u05df"
    }
  },
  "required": [
    "student_answer",
    "subject"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}