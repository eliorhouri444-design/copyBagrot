{
  "name": "ModuleDefinition",
  "type": "object",
  "properties": {
    "module_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05d5\u05d3\u05d5\u05dc (A, B, C \u05d5\u05db\u05d5')"
    },
    "title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05de\u05d5\u05d3\u05d5\u05dc"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05e7\u05e6\u05e8"
    },
    "details": {
      "type": "string",
      "description": "\u05e4\u05e8\u05d8\u05d9\u05dd \u05de\u05dc\u05d0\u05d9\u05dd"
    },
    "duration": {
      "type": "integer",
      "description": "\u05de\u05e9\u05da \u05d1\u05d3\u05e7\u05d5\u05ea"
    },
    "color": {
      "type": "string",
      "description": "\u05e6\u05d1\u05e2 gradient (Tailwind classes)"
    },
    "points": {
      "type": "string",
      "description": "\u05e0\u05e7\u05d5\u05d3\u05d5\u05ea (\u05dc\u05d3\u05d5\u05d2\u05de\u05d4: '70 + 30')"
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05d7\u05dc\u05e7\u05d9 \u05d4\u05de\u05d5\u05d3\u05d5\u05dc"
    },
    "subject": {
      "type": "string",
      "description": "\u05de\u05e7\u05e6\u05d5\u05e2"
    },
    "unit_level": {
      "type": "integer",
      "enum": [
        3,
        4,
        5
      ],
      "description": "\u05e8\u05de\u05ea \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea"
    },
    "entity": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4-entity \u05e9\u05dc \u05d4\u05de\u05d1\u05d7\u05e0\u05d9\u05dd"
    },
    "order": {
      "type": "integer",
      "description": "\u05e1\u05d3\u05e8 \u05ea\u05e6\u05d5\u05d2\u05d4"
    }
  },
  "required": [
    "module_id",
    "title",
    "subject",
    "unit_level",
    "order"
  ],
  "rls": {
    "read": {},
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}