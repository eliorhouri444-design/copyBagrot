{
  "name": "GrammarProgress",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "subject_id": {
      "type": "string",
      "description": "\u05d4\u05de\u05e7\u05e6\u05d5\u05e2"
    },
    "unit_level": {
      "type": "integer",
      "description": "\u05e8\u05de\u05ea \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea"
    },
    "topic": {
      "type": "string",
      "description": "\u05e0\u05d5\u05e9\u05d0 \u05d4\u05d3\u05e7\u05d3\u05d5\u05e7"
    },
    "question_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e9\u05d0\u05dc\u05d4"
    },
    "times_seen": {
      "type": "integer",
      "default": 0
    },
    "times_correct": {
      "type": "integer",
      "default": 0
    },
    "times_incorrect": {
      "type": "integer",
      "default": 0
    },
    "is_weak": {
      "type": "boolean",
      "default": false
    },
    "is_mastered": {
      "type": "boolean",
      "default": false
    },
    "last_practiced": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_email",
    "question_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}