{
  "name": "TopicNew",
  "type": "object",
  "properties": {
    "topic_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e0\u05d5\u05e9\u05d0 (math_trig_identities)"
    },
    "subject_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e7\u05e6\u05d5\u05e2"
    },
    "unit_level": {
      "type": "integer",
      "description": "\u05e8\u05de\u05ea \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea (0 \u05d0\u05dd \u05dc\u05d0 \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9)"
    },
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e0\u05d5\u05e9\u05d0"
    },
    "parent_topic_id": {
      "type": "string",
      "description": "\u05e0\u05d5\u05e9\u05d0 \u05d0\u05d1 (\u05d0\u05dd \u05d6\u05d4 \u05ea\u05ea-\u05e0\u05d5\u05e9\u05d0)"
    },
    "order": {
      "type": "integer",
      "default": 0,
      "description": "\u05e1\u05d3\u05e8 \u05d4\u05ea\u05e6\u05d5\u05d2\u05d4"
    },
    "icon": {
      "type": "string",
      "description": "\u05d0\u05d9\u05d9\u05e7\u05d5\u05df"
    },
    "color": {
      "type": "string",
      "description": "\u05e6\u05d1\u05e2 \u05e8\u05e7\u05e2 (Tailwind gradient classes)"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05e0\u05d5\u05e9\u05d0"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "topic_id",
    "subject_id",
    "name"
  ],
  "rls": {
    "read": {},
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}