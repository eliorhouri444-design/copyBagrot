{
  "name": "ModuleAExam",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05de\u05d1\u05d7\u05df"
    },
    "subject": {
      "type": "string",
      "description": "\u05de\u05e7\u05e6\u05d5\u05e2"
    },
    "unit_level": {
      "type": "integer",
      "enum": [
        3,
        4,
        5
      ],
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea"
    },
    "reading_text": {
      "type": "string",
      "description": "\u05d8\u05e7\u05e1\u05d8 \u05dc\u05d4\u05d1\u05e0\u05ea \u05d4\u05e0\u05e7\u05e8\u05d0"
    },
    "reading_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_number": {
            "type": "integer"
          },
          "question_type": {
            "type": "string",
            "enum": [
              "multiple_choice",
              "short_answer"
            ]
          },
          "question_text": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correct_answer": {
            "type": "string"
          },
          "points": {
            "type": "integer"
          }
        }
      },
      "description": "\u05e9\u05d0\u05dc\u05d5\u05ea \u05d4\u05d1\u05e0\u05ea \u05d4\u05e0\u05e7\u05e8\u05d0"
    },
    "listening_audio_url": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05e7\u05d5\u05d1\u05e5 \u05d4\u05e9\u05de\u05e2"
    },
    "listening_caption_url": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05e7\u05d5\u05d1\u05e5 VTT/SRT"
    },
    "listening_transcript": {
      "type": "string",
      "description": "\u05ea\u05de\u05dc\u05d5\u05dc \u05d4\u05e9\u05d9\u05d7\u05d4"
    },
    "listening_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_number": {
            "type": "integer"
          },
          "question_text": {
            "type": "string"
          },
          "correct_answer": {
            "type": "string"
          },
          "points": {
            "type": "integer"
          }
        }
      },
      "description": "\u05e9\u05d0\u05dc\u05d5\u05ea \u05d4\u05d0\u05d6\u05e0\u05d4"
    },
    "duration_minutes": {
      "type": "integer",
      "default": 45
    },
    "total_reading_points": {
      "type": "integer",
      "default": 70
    },
    "total_listening_points": {
      "type": "integer",
      "default": 30
    },
    "passing_grade": {
      "type": "integer",
      "default": 56
    }
  },
  "required": [
    "title",
    "subject",
    "unit_level",
    "reading_text",
    "reading_questions",
    "listening_questions"
  ],
  "rls": {
    "read": {},
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}