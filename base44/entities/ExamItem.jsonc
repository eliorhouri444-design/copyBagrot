{
  "name": "ExamItem",
  "type": "object",
  "properties": {
    "exam_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05d1\u05d7\u05df"
    },
    "module": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d5\u05d3\u05d5\u05dc (A, B, C \u05d5\u05db\u05d5')"
    },
    "question_number": {
      "type": "integer",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05e9\u05d0\u05dc\u05d4"
    },
    "question_type": {
      "type": "string",
      "enum": [
        "multiple_choice",
        "fill_in_blank",
        "short_answer",
        "writing",
        "listening"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05e9\u05d0\u05dc\u05d4"
    },
    "question_text": {
      "type": "string",
      "description": "\u05d8\u05e7\u05e1\u05d8 \u05d4\u05e9\u05d0\u05dc\u05d4"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05d0\u05e4\u05e9\u05e8\u05d5\u05d9\u05d5\u05ea \u05ea\u05e9\u05d5\u05d1\u05d4"
    },
    "correct_answers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05ea\u05e9\u05d5\u05d1\u05d5\u05ea \u05e0\u05db\u05d5\u05e0\u05d5\u05ea"
    },
    "explanation": {
      "type": "string",
      "description": "\u05d4\u05e1\u05d1\u05e8 \u05dc\u05ea\u05e9\u05d5\u05d1\u05d4"
    },
    "points": {
      "type": "integer",
      "default": 10,
      "description": "\u05e0\u05e7\u05d5\u05d3\u05d5\u05ea \u05dc\u05e9\u05d0\u05dc\u05d4"
    },
    "audio_url": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05e7\u05d5\u05d1\u05e5 \u05e9\u05de\u05e2 (\u05dc\u05e9\u05d0\u05dc\u05d5\u05ea listening)"
    }
  },
  "required": [
    "exam_id",
    "module",
    "question_number",
    "question_type",
    "question_text",
    "correct_answers",
    "points"
  ],
  "rls": {
    "read": {},
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}