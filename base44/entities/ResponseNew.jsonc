{
  "name": "ResponseNew",
  "type": "object",
  "properties": {
    "response_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05dc\u05ea\u05e9\u05d5\u05d1\u05d4"
    },
    "attempt_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e0\u05d9\u05e1\u05d9\u05d5\u05df (FK)"
    },
    "question_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e9\u05d0\u05dc\u05d4 (FK)"
    },
    "user_input_raw": {
      "type": "string",
      "description": "\u05e7\u05dc\u05d8 \u05d2\u05d5\u05dc\u05de\u05d9 \u05de\u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "user_input_struct": {
      "type": "object",
      "description": "\u05e7\u05dc\u05d8 \u05de\u05d5\u05d1\u05e0\u05d4 (JSON)",
      "properties": {
        "selected_options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "numeric_value": {
          "type": "number"
        },
        "algebraic_expression": {
          "type": "string"
        },
        "graph_state": {
          "type": "object"
        },
        "text_answer": {
          "type": "string"
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "is_correct": {
      "type": "boolean",
      "description": "\u05d4\u05d0\u05dd \u05d4\u05ea\u05e9\u05d5\u05d1\u05d4 \u05e0\u05db\u05d5\u05e0\u05d4"
    },
    "partial_credit": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "\u05e6\u05d9\u05d5\u05df \u05d7\u05dc\u05e7\u05d9 (0-1)"
    },
    "feedback_text": {
      "type": "string",
      "description": "\u05de\u05e9\u05d5\u05d1 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9 \u05d0\u05d5 \u05d9\u05d3\u05e0\u05d9"
    },
    "time_spent_sec": {
      "type": "integer",
      "description": "\u05d6\u05de\u05df \u05e9\u05d4\u05d5\u05e9\u05e7\u05e2 (\u05e9\u05e0\u05d9\u05d5\u05ea)"
    },
    "hints_used": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e8\u05de\u05d6\u05d9\u05dd \u05e9\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05d4\u05dd"
    }
  },
  "required": [
    "response_id",
    "attempt_id",
    "question_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}