{
  "name": "GrammarQuestion",
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string",
      "description": "\u05d4\u05de\u05e7\u05e6\u05d5\u05e2 (\u05d0\u05e0\u05d2\u05dc\u05d9\u05ea)"
    },
    "unit_level": {
      "type": "integer",
      "description": "\u05e8\u05de\u05ea \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea (3/4/5)"
    },
    "topic": {
      "type": "string",
      "description": "\u05e0\u05d5\u05e9\u05d0 \u05d4\u05d3\u05e7\u05d3\u05d5\u05e7 (Present Simple, Past Simple \u05d5\u05db\u05d5')"
    },
    "question_type": {
      "type": "string",
      "enum": [
        "multiple_choice",
        "free_write",
        "fill_blank"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05e9\u05d0\u05dc\u05d4"
    },
    "question": {
      "type": "string",
      "description": "\u05d8\u05e7\u05e1\u05d8 \u05d4\u05e9\u05d0\u05dc\u05d4"
    },
    "answer": {
      "type": "string",
      "description": "\u05d4\u05ea\u05e9\u05d5\u05d1\u05d4 \u05d4\u05e0\u05db\u05d5\u05e0\u05d4"
    },
    "acceptable_answers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05ea\u05e9\u05d5\u05d1\u05d5\u05ea \u05de\u05e7\u05d5\u05d1\u05dc\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05d0\u05e4\u05e9\u05e8\u05d5\u05d9\u05d5\u05ea \u05dc\u05d1\u05d7\u05d9\u05e8\u05d4 (\u05dc\u05e9\u05d0\u05dc\u05d5\u05ea multiple_choice)"
    },
    "explanation": {
      "type": "string",
      "description": "\u05d4\u05e1\u05d1\u05e8 \u05dc\u05ea\u05e9\u05d5\u05d1\u05d4"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ],
      "default": "easy"
    },
    "set_number": {
      "type": "integer",
      "default": 1,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05e1\u05d8 (\u05db\u05dc \u05e1\u05d8 = 10 \u05e9\u05d0\u05dc\u05d5\u05ea)"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "subject_id",
    "unit_level",
    "topic",
    "question_type",
    "question",
    "answer"
  ],
  "rls": {
    "read": {},
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}