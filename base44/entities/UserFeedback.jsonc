{
  "name": "UserFeedback",
  "type": "object",
  "properties": {
    "message_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d4\u05d5\u05d3\u05e2\u05d4 \u05e9\u05d3\u05d5\u05d5\u05d7\u05d4"
    },
    "conversation_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e9\u05d9\u05d7\u05d4"
    },
    "original_question": {
      "type": "string",
      "description": "\u05d4\u05e9\u05d0\u05dc\u05d4 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9\u05ea"
    },
    "ai_answer": {
      "type": "string",
      "description": "\u05d4\u05ea\u05e9\u05d5\u05d1\u05d4 \u05e9\u05dc \u05d4-AI"
    },
    "feedback_type": {
      "type": "string",
      "enum": [
        "missing_line",
        "wrong_interpretation",
        "wrong_diagram",
        "wrong_calculation",
        "missing_info",
        "irrelevant_explanation",
        "wrong_graph",
        "language_issue",
        "other"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d1\u05e2\u05d9\u05d4"
    },
    "user_description": {
      "type": "string",
      "description": "\u05d4\u05e1\u05d1\u05e8 \u05de\u05e4\u05d5\u05e8\u05d8 \u05de\u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "subject": {
      "type": "string",
      "description": "\u05d4\u05de\u05e7\u05e6\u05d5\u05e2"
    },
    "topic": {
      "type": "string",
      "description": "\u05d4\u05e0\u05d5\u05e9\u05d0"
    },
    "units": {
      "type": "integer",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea"
    },
    "severity": {
      "type": "string",
      "enum": [
        "minor",
        "moderate",
        "critical"
      ],
      "default": "moderate",
      "description": "\u05d7\u05d5\u05de\u05e8\u05ea \u05d4\u05d1\u05e2\u05d9\u05d4"
    },
    "image_url": {
      "type": "string",
      "description": "\u05ea\u05de\u05d5\u05e0\u05ea \u05d4\u05e9\u05d0\u05dc\u05d4 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9\u05ea"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "fixed",
        "dismissed"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc"
    },
    "admin_response": {
      "type": "string",
      "description": "\u05ea\u05d2\u05d5\u05d1\u05ea \u05d4\u05d0\u05d3\u05de\u05d9\u05df"
    },
    "was_applied": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05e4\u05d9\u05d3\u05d1\u05e7 \u05e9\u05d5\u05dc\u05d1 \u05d1\u05de\u05e2\u05e8\u05db\u05ea"
    },
    "learning_impact": {
      "type": "object",
      "description": "\u05d4\u05e9\u05e4\u05e2\u05d4 \u05e2\u05dc \u05dc\u05de\u05d9\u05d3\u05ea \u05d4\u05de\u05e2\u05e8\u05db\u05ea",
      "properties": {
        "prompt_updated": {
          "type": "boolean"
        },
        "similar_feedbacks_count": {
          "type": "integer"
        },
        "priority_score": {
          "type": "number"
        }
      }
    }
  },
  "required": [
    "message_id",
    "original_question",
    "ai_answer",
    "feedback_type",
    "subject"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {}
  }
}