{
  "name": "PracticeSession",
  "type": "object",
  "properties": {
    "topic": {
      "type": "string",
      "enum": [
        "vocabulary",
        "reading_comprehension",
        "grammar",
        "writing",
        "listening"
      ],
      "description": "\u05e0\u05d5\u05e9\u05d0 \u05d4\u05ea\u05e8\u05d2\u05d5\u05dc"
    },
    "score": {
      "type": "number",
      "description": "\u05e6\u05d9\u05d5\u05df \u05d1\u05d0\u05d7\u05d5\u05d6\u05d9\u05dd"
    },
    "duration": {
      "type": "integer",
      "description": "\u05de\u05e9\u05da \u05d4\u05ea\u05e8\u05d2\u05d5\u05dc \u05d1\u05d3\u05e7\u05d5\u05ea"
    },
    "questions_total": {
      "type": "integer",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e9\u05d0\u05dc\u05d5\u05ea \u05db\u05d5\u05dc\u05dc"
    },
    "questions_correct": {
      "type": "integer",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e9\u05d0\u05dc\u05d5\u05ea \u05e0\u05db\u05d5\u05e0\u05d5\u05ea"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "default": "intermediate"
    },
    "subject": {
      "type": "string",
      "description": "\u05d4\u05de\u05e7\u05e6\u05d5\u05e2 \u05e9\u05dc \u05d4\u05ea\u05e8\u05d2\u05d5\u05dc"
    },
    "units": {
      "type": "integer",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea"
    }
  },
  "required": [
    "topic",
    "score",
    "duration",
    "subject",
    "units"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}