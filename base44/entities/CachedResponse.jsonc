{
  "name": "CachedResponse",
  "type": "object",
  "properties": {
    "question_hash": {
      "type": "string",
      "description": "Hash \u05e9\u05dc \u05d4\u05e9\u05d0\u05dc\u05d4 \u05dc\u05d6\u05d9\u05d4\u05d5\u05d9 \u05de\u05d4\u05d9\u05e8"
    },
    "question_text": {
      "type": "string",
      "description": "\u05d8\u05e7\u05e1\u05d8 \u05d4\u05e9\u05d0\u05dc\u05d4 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9"
    },
    "subject": {
      "type": "string",
      "enum": [
        "\u05de\u05ea\u05de\u05d8\u05d9\u05e7\u05d4",
        "\u05e4\u05d9\u05d6\u05d9\u05e7\u05d4",
        "\u05db\u05d9\u05de\u05d9\u05d4",
        "\u05d1\u05d9\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4"
      ],
      "description": "\u05d4\u05de\u05e7\u05e6\u05d5\u05e2"
    },
    "response_data": {
      "type": "object",
      "description": "\u05d4\u05ea\u05e9\u05d5\u05d1\u05d4 \u05d4\u05de\u05dc\u05d0\u05d4 (JSON)"
    },
    "model_used": {
      "type": "string",
      "description": "\u05d4\u05de\u05d5\u05d3\u05dc \u05e9\u05e9\u05d9\u05de\u05e9 (gpt-4o/gpt-4o-mini)"
    },
    "hit_count": {
      "type": "integer",
      "default": 0,
      "description": "\u05db\u05de\u05d4 \u05e4\u05e2\u05de\u05d9\u05dd \u05e0\u05de\u05e9\u05da \u05de\u05d4-cache"
    },
    "last_accessed": {
      "type": "string",
      "format": "date-time",
      "description": "\u05d2\u05d9\u05e9\u05d4 \u05d0\u05d7\u05e8\u05d5\u05e0\u05d4"
    }
  },
  "required": [
    "question_hash",
    "question_text",
    "subject",
    "response_data"
  ],
  "rls": {
    "read": {},
    "write": {}
  }
}