{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e9\u05d9\u05d7\u05d4 (session)"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ],
      "description": "\u05de\u05d9 \u05e9\u05dc\u05d7 \u05d0\u05ea \u05d4\u05d4\u05d5\u05d3\u05e2\u05d4"
    },
    "content": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05d4\u05d5\u05d3\u05e2\u05d4"
    },
    "subject": {
      "type": "string",
      "description": "\u05d4\u05de\u05e7\u05e6\u05d5\u05e2 \u05e9\u05d1\u05d4\u05e7\u05e9\u05e8\u05d5 \u05e0\u05e9\u05dc\u05d7\u05d4 \u05d4\u05d4\u05d5\u05d3\u05e2\u05d4"
    },
    "unit_level": {
      "type": "integer",
      "description": "\u05e8\u05de\u05ea \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea"
    },
    "context_data": {
      "type": "object",
      "description": "\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05d9\u05dd \u05e9\u05d4\u05d5\u05e2\u05d1\u05e8\u05d5 \u05dc-AI",
      "properties": {
        "weak_topics": {
          "type": "array"
        },
        "recent_scores": {
          "type": "array"
        },
        "user_preferences": {
          "type": "object"
        }
      }
    },
    "tokens_used": {
      "type": "integer",
      "description": "\u05db\u05de\u05d5\u05ea \u05d8\u05d5\u05e7\u05e0\u05d9\u05dd \u05e9\u05e0\u05d5\u05e6\u05dc\u05d4"
    },
    "response_time_ms": {
      "type": "integer",
      "description": "\u05d6\u05de\u05df \u05ea\u05d2\u05d5\u05d1\u05d4 \u05d1\u05de\u05d9\u05dc\u05d9\u05e9\u05e0\u05d9\u05d5\u05ea"
    }
  },
  "required": [
    "conversation_id",
    "role",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}