{
  "name": "ModuleBResult",
  "type": "object",
  "properties": {
    "exam_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05d1\u05d7\u05df"
    },
    "grammar_score": {
      "type": "number",
      "description": "\u05e6\u05d9\u05d5\u05df \u05d3\u05e7\u05d3\u05d5\u05e7 (0-70)"
    },
    "writing_score": {
      "type": "number",
      "description": "\u05e6\u05d9\u05d5\u05df \u05db\u05ea\u05d9\u05d1\u05d4 (0-30)"
    },
    "final_score": {
      "type": "number",
      "description": "\u05e6\u05d9\u05d5\u05df \u05e1\u05d5\u05e4\u05d9 (0-100)"
    },
    "grammar_answers": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "\u05ea\u05e9\u05d5\u05d1\u05d5\u05ea \u05d3\u05e7\u05d3\u05d5\u05e7"
    },
    "writing_text": {
      "type": "string",
      "description": "\u05d4\u05d8\u05e7\u05e1\u05d8 \u05e9\u05e0\u05db\u05ea\u05d1"
    },
    "word_count": {
      "type": "integer",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05de\u05d9\u05dc\u05d9\u05dd"
    },
    "duration": {
      "type": "integer",
      "description": "\u05de\u05e9\u05da \u05d6\u05de\u05df \u05d1\u05d3\u05e7\u05d5\u05ea"
    },
    "passed": {
      "type": "boolean",
      "description": "\u05d4\u05d0\u05dd \u05e2\u05d1\u05e8 (56+)"
    },
    "subject": {
      "type": "string"
    },
    "unit_level": {
      "type": "integer"
    }
  },
  "required": [
    "exam_id",
    "final_score",
    "subject",
    "unit_level",
    "passed"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}