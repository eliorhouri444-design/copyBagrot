{
  "name": "VocabularySession",
  "type": "object",
  "properties": {
    "session_type": {
      "type": "string",
      "enum": [
        "flashcards",
        "quick_practice",
        "weak_words",
        "error_practice"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05e1\u05e9\u05df"
    },
    "user_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "subject_id": {
      "type": "string",
      "description": "\u05d4\u05de\u05e7\u05e6\u05d5\u05e2"
    },
    "unit_level": {
      "type": "integer",
      "description": "\u05e8\u05de\u05ea \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea"
    },
    "topic_id": {
      "type": "string",
      "description": "\u05e0\u05d5\u05e9\u05d0 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9"
    },
    "words_practiced": {
      "type": "integer",
      "default": 0,
      "description": "\u05db\u05de\u05d4 \u05de\u05d9\u05dc\u05d9\u05dd \u05ea\u05d5\u05e8\u05d2\u05dc\u05d5"
    },
    "correct_answers": {
      "type": "integer",
      "default": 0,
      "description": "\u05ea\u05e9\u05d5\u05d1\u05d5\u05ea \u05e0\u05db\u05d5\u05e0\u05d5\u05ea"
    },
    "incorrect_answers": {
      "type": "integer",
      "default": 0,
      "description": "\u05ea\u05e9\u05d5\u05d1\u05d5\u05ea \u05e9\u05d2\u05d5\u05d9\u05d5\u05ea"
    },
    "accuracy": {
      "type": "number",
      "description": "\u05d0\u05d7\u05d5\u05d6 \u05d3\u05d9\u05d5\u05e7"
    },
    "duration_seconds": {
      "type": "integer",
      "description": "\u05de\u05e9\u05da \u05d4\u05e1\u05e9\u05df \u05d1\u05e9\u05e0\u05d9\u05d5\u05ea"
    },
    "weak_words_found": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05d9\u05dc\u05d9\u05dd \u05d7\u05dc\u05e9\u05d5\u05ea \u05e9\u05d4\u05ea\u05d2\u05dc\u05d5"
    },
    "is_completed": {
      "type": "boolean",
      "default": false
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "session_type",
    "user_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}