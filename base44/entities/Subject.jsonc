{
  "name": "Subject",
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e7\u05e6\u05d5\u05e2 (math, english, physics, etc.)"
    },
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e7\u05e6\u05d5\u05e2 \u05d1\u05e2\u05d1\u05e8\u05d9\u05ea"
    },
    "name_en": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e7\u05e6\u05d5\u05e2 \u05d1\u05d0\u05e0\u05d2\u05dc\u05d9\u05ea"
    },
    "has_units": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d9\u05e9 \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea \u05dc\u05de\u05e7\u05e6\u05d5\u05e2 \u05d6\u05d4"
    },
    "units": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea (3, 4, 5)"
    },
    "icon": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d0\u05d9\u05d9\u05e7\u05d5\u05df"
    },
    "color": {
      "type": "string",
      "description": "\u05e6\u05d1\u05e2 \u05d4\u05de\u05e7\u05e6\u05d5\u05e2"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05e7\u05e6\u05d5\u05e2 \u05e4\u05e2\u05d9\u05dc"
    }
  },
  "required": [
    "subject_id",
    "name"
  ],
  "rls": {
    "read": {},
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}