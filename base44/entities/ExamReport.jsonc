{
  "name": "ExamReport",
  "type": "object",
  "properties": {
    "exam_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05d1\u05d7\u05df"
    },
    "question_number": {
      "type": "integer",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05e9\u05d0\u05dc\u05d4"
    },
    "report_text": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05d3\u05d9\u05d5\u05d5\u05d7"
    },
    "report_type": {
      "type": "string",
      "enum": [
        "wrong_answer",
        "typo",
        "unclear",
        "technical",
        "other"
      ],
      "default": "other",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d3\u05d9\u05d5\u05d5\u05d7"
    },
    "subject": {
      "type": "string",
      "description": "\u05de\u05e7\u05e6\u05d5\u05e2"
    },
    "unit_level": {
      "type": "integer",
      "description": "\u05e8\u05de\u05ea \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea"
    },
    "user_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05de\u05d3\u05d5\u05d5\u05d7"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "fixed",
        "dismissed"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d8\u05d9\u05e4\u05d5\u05dc"
    },
    "admin_notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05de\u05e0\u05d4\u05dc"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05ea\u05d9 \u05d8\u05d5\u05e4\u05dc"
    }
  },
  "required": [
    "exam_id",
    "question_number",
    "report_text",
    "subject"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {}
  }
}