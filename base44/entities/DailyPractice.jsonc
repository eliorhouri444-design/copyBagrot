{
  "name": "DailyPractice",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05de\u05e9\u05d9\u05de\u05d4 \u05d4\u05d9\u05d5\u05de\u05d9\u05ea"
    },
    "user_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "subject_id": {
      "type": "string",
      "description": "\u05d4\u05de\u05e7\u05e6\u05d5\u05e2"
    },
    "unit_level": {
      "type": "integer",
      "description": "\u05e8\u05de\u05ea \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "task_type": {
            "type": "string",
            "enum": [
              "review",
              "new_content",
              "quiz",
              "exam",
              "bonus"
            ]
          },
          "topic_id": {
            "type": "string"
          },
          "question_count": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "done",
              "skipped"
            ],
            "default": "pending"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          },
          "score": {
            "type": "number"
          }
        }
      },
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05d4\u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05d4\u05d9\u05d5\u05de\u05d9\u05d5\u05ea"
    },
    "total_questions": {
      "type": "integer",
      "default": 0,
      "description": "\u05e1\u05da \u05d4\u05e9\u05d0\u05dc\u05d5\u05ea \u05d4\u05d9\u05d5\u05dd"
    },
    "completed_questions": {
      "type": "integer",
      "default": 0,
      "description": "\u05db\u05de\u05d4 \u05e9\u05d0\u05dc\u05d5\u05ea \u05d4\u05d5\u05e9\u05dc\u05de\u05d5"
    },
    "daily_goal": {
      "type": "integer",
      "description": "\u05d9\u05e2\u05d3 \u05d4\u05e9\u05d0\u05dc\u05d5\u05ea \u05dc\u05d4\u05d9\u05d5\u05dd"
    },
    "streak_days": {
      "type": "integer",
      "default": 0,
      "description": "\u05db\u05de\u05d4 \u05d9\u05de\u05d9\u05dd \u05e8\u05e6\u05d5\u05e4\u05d9\u05dd \u05dc\u05de\u05d3"
    },
    "is_completed": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05e1\u05d9\u05d9\u05dd \u05d0\u05ea \u05db\u05dc \u05d4\u05de\u05e9\u05d9\u05de\u05d5\u05ea"
    },
    "completion_time": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05ea\u05d9 \u05e1\u05d9\u05d9\u05dd"
    }
  },
  "required": [
    "date",
    "user_email",
    "subject_id",
    "unit_level"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {}
  }
}