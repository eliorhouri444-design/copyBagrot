{
  "name": "StudyGoals",
  "type": "object",
  "properties": {
    "subject": {
      "type": "string",
      "description": "\u05d4\u05de\u05e7\u05e6\u05d5\u05e2"
    },
    "unit_level": {
      "type": "integer",
      "enum": [
        3,
        4,
        5
      ],
      "description": "\u05e8\u05de\u05ea \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea"
    },
    "exam_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d1\u05d2\u05e8\u05d5\u05ea"
    },
    "daily_goal": {
      "type": "object",
      "properties": {
        "practice_minutes": {
          "type": "integer",
          "description": "\u05d3\u05e7\u05d5\u05ea \u05ea\u05e8\u05d2\u05d5\u05dc \u05d1\u05d9\u05d5\u05dd"
        },
        "questions": {
          "type": "integer",
          "description": "\u05e9\u05d0\u05dc\u05d5\u05ea \u05d1\u05d9\u05d5\u05dd"
        }
      }
    },
    "weekly_goal": {
      "type": "object",
      "properties": {
        "practice_sessions": {
          "type": "integer",
          "description": "\u05de\u05e1\u05e4\u05e8 \u05ea\u05e8\u05d2\u05d5\u05dc\u05d9\u05dd \u05d1\u05e9\u05d1\u05d5\u05e2"
        },
        "exams": {
          "type": "integer",
          "description": "\u05de\u05d1\u05d7\u05e0\u05d9\u05dd \u05d1\u05e9\u05d1\u05d5\u05e2"
        },
        "hours": {
          "type": "number",
          "description": "\u05e9\u05e2\u05d5\u05ea \u05dc\u05d9\u05de\u05d5\u05d3 \u05d1\u05e9\u05d1\u05d5\u05e2"
        }
      }
    },
    "monthly_goal": {
      "type": "object",
      "properties": {
        "practice_sessions": {
          "type": "integer",
          "description": "\u05ea\u05e8\u05d2\u05d5\u05dc\u05d9\u05dd \u05d1\u05d7\u05d5\u05d3\u05e9"
        },
        "exams": {
          "type": "integer",
          "description": "\u05de\u05d1\u05d7\u05e0\u05d9\u05dd \u05d1\u05d7\u05d5\u05d3\u05e9"
        },
        "hours": {
          "type": "number",
          "description": "\u05e9\u05e2\u05d5\u05ea \u05dc\u05d9\u05de\u05d5\u05d3 \u05d1\u05d7\u05d5\u05d3\u05e9"
        }
      }
    },
    "recommended_totals": {
      "type": "object",
      "properties": {
        "total_practice_before_exam": {
          "type": "integer",
          "description": "\u05e1\u05da \u05ea\u05e8\u05d2\u05d5\u05dc\u05d9\u05dd \u05de\u05d5\u05de\u05dc\u05e6\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d1\u05d2\u05e8\u05d5\u05ea"
        },
        "total_exams_before_exam": {
          "type": "integer",
          "description": "\u05e1\u05da \u05de\u05d1\u05d7\u05e0\u05d9\u05dd \u05de\u05d5\u05de\u05dc\u05e6\u05d9\u05dd \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d1\u05d2\u05e8\u05d5\u05ea"
        },
        "total_hours_before_exam": {
          "type": "number",
          "description": "\u05e1\u05da \u05e9\u05e2\u05d5\u05ea \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d1\u05d2\u05e8\u05d5\u05ea"
        }
      }
    },
    "current_progress": {
      "type": "object",
      "properties": {
        "total_practice": {
          "type": "integer",
          "default": 0
        },
        "total_exams": {
          "type": "integer",
          "default": 0
        },
        "total_hours": {
          "type": "number",
          "default": 0
        },
        "today_minutes": {
          "type": "integer",
          "default": 0
        },
        "this_week_sessions": {
          "type": "integer",
          "default": 0
        },
        "this_month_sessions": {
          "type": "integer",
          "default": 0
        }
      }
    },
    "missed_goals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "goal_type": {
            "type": "string",
            "enum": [
              "daily",
              "weekly",
              "monthly"
            ]
          },
          "notification_sent": {
            "type": "boolean"
          }
        }
      },
      "description": "\u05d9\u05e2\u05d3\u05d9\u05dd \u05e9\u05dc\u05d0 \u05d4\u05d5\u05e9\u05d2\u05d5"
    }
  },
  "required": [
    "subject",
    "unit_level"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}