{
  "name": "DailyQuiz",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d1\u05d5\u05d7\u05df"
    },
    "user_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "subject_id": {
      "type": "string",
      "description": "\u05d4\u05de\u05e7\u05e6\u05d5\u05e2"
    },
    "unit_level": {
      "type": "integer",
      "description": "\u05e8\u05de\u05ea \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string"
          },
          "topic_id": {
            "type": "string"
          },
          "is_weak_topic": {
            "type": "boolean",
            "description": "\u05d4\u05d0\u05dd \u05d6\u05d4 \u05de\u05e0\u05d5\u05e9\u05d0 \u05d7\u05dc\u05e9"
          }
        }
      },
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05d4\u05e9\u05d0\u05dc\u05d5\u05ea \u05d1\u05d1\u05d5\u05d7\u05df"
    },
    "total_questions": {
      "type": "integer",
      "default": 10,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e9\u05d0\u05dc\u05d5\u05ea \u05d1\u05d1\u05d5\u05d7\u05df"
    },
    "score": {
      "type": "number",
      "description": "\u05e6\u05d9\u05d5\u05df 0-100"
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "\u05ea\u05e9\u05d5\u05d1\u05d5\u05ea \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "is_completed": {
      "type": "boolean",
      "default": false
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05d4\u05de\u05dc\u05e6\u05d5\u05ea \u05dc\u05dc\u05d9\u05de\u05d5\u05d3 \u05de\u05d7\u05e8"
    },
    "insights": {
      "type": "string",
      "description": "\u05ea\u05d5\u05d1\u05e0\u05d5\u05ea \u05de\u05d4\u05d1\u05d5\u05d7\u05df"
    }
  },
  "required": [
    "date",
    "user_email",
    "subject_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}