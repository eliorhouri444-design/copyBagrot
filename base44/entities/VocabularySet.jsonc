{
  "name": "VocabularySet",
  "type": "object",
  "properties": {
    "set_number": {
      "type": "integer",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05e1\u05d8 (1-10 \u05d5\u05db\u05d5')"
    },
    "subject_id": {
      "type": "string",
      "description": "\u05de\u05e7\u05e6\u05d5\u05e2"
    },
    "unit_level": {
      "type": "integer",
      "description": "\u05e8\u05de\u05ea \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea"
    },
    "title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05e1\u05d8"
    },
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "english": {
            "type": "string"
          },
          "hebrew": {
            "type": "string"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "translate",
                    "fill",
                    "choose"
                  ]
                },
                "q": {
                  "type": "string"
                },
                "a": {
                  "type": "string"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "description": "\u05de\u05d9\u05dc\u05d9\u05dd \u05d1\u05e1\u05d8 (\u05e2\u05d3 10)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  },
  "required": [
    "set_number",
    "subject_id",
    "unit_level",
    "words"
  ],
  "rls": {
    "read": {},
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}