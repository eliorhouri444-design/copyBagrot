{
  "name": "Achievement",
  "type": "object",
  "properties": {
    "achievement_type": {
      "type": "string",
      "enum": [
        "consistent",
        "improved_10",
        "improved_20",
        "reached_target",
        "perfect_score",
        "week_streak",
        "month_streak"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d4\u05d9\u05e9\u05d2"
    },
    "title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05d4\u05d9\u05e9\u05d2"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05d4\u05d9\u05e9\u05d2"
    },
    "icon": {
      "type": "string",
      "description": "\u05d0\u05d9\u05d9\u05e7\u05d5\u05df"
    },
    "earned_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05ea\u05d9 \u05d4\u05d5\u05e9\u05d2"
    },
    "subject": {
      "type": "string",
      "description": "\u05de\u05e7\u05e6\u05d5\u05e2 \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9"
    },
    "badge_color": {
      "type": "string",
      "description": "\u05e6\u05d1\u05e2 \u05d4\u05ea\u05d2"
    }
  },
  "required": [
    "achievement_type",
    "title",
    "earned_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}