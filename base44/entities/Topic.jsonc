{
  "name": "Topic",
  "type": "object",
  "properties": {
    "subject": {
      "type": "string",
      "description": "\u05d4\u05de\u05e7\u05e6\u05d5\u05e2"
    },
    "unit_level": {
      "type": "integer",
      "enum": [
        3,
        4,
        5
      ],
      "description": "\u05e8\u05de\u05ea \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea"
    },
    "title": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e0\u05d5\u05e9\u05d0"
    },
    "subtitle": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05de\u05e9\u05e0\u05d4"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05e0\u05d5\u05e9\u05d0"
    },
    "topic_key": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e0\u05d5\u05e9\u05d0 (vocabulary, grammar \u05d5\u05db\u05d5')"
    },
    "order": {
      "type": "integer",
      "description": "\u05e1\u05d3\u05e8 \u05d4\u05ea\u05e6\u05d5\u05d2\u05d4"
    },
    "target_items": {
      "type": "integer",
      "description": "\u05d9\u05e2\u05d3 \u05de\u05e1\u05e4\u05e8 \u05e4\u05e8\u05d9\u05d8\u05d9\u05dd"
    },
    "weight": {
      "type": "number",
      "description": "\u05de\u05e9\u05e7\u05dc \u05d1\u05d7\u05d9\u05e9\u05d5\u05d1 \u05d4\u05ea\u05e7\u05d3\u05de\u05d5\u05ea \u05db\u05d5\u05dc\u05dc\u05ea"
    },
    "color": {
      "type": "string",
      "description": "\u05e6\u05d1\u05e2 \u05d4\u05db\u05e8\u05d8\u05d9\u05e1"
    },
    "icon": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d0\u05d9\u05d9\u05e7\u05d5\u05df"
    },
    "is_premium": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d3\u05d5\u05e8\u05e9 \u05de\u05e0\u05d5\u05d9 \u05e4\u05e8\u05d9\u05de\u05d9\u05d5\u05dd"
    }
  },
  "required": [
    "subject",
    "unit_level",
    "title",
    "topic_key",
    "order",
    "target_items",
    "weight"
  ],
  "rls": {
    "read": {},
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}