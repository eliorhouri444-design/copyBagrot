{
  "name": "ReferralClick",
  "type": "object",
  "properties": {
    "referrer_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05d4\u05e4\u05e0\u05d4"
    },
    "referral_code": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d3 \u05d4\u05d4\u05e4\u05e0\u05d9\u05d4 \u05d4\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9"
    },
    "clicked_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05e7\u05dc\u05d9\u05e7"
    },
    "visitor_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05e9\u05dc \u05d4\u05de\u05d1\u05e7\u05e8"
    }
  },
  "required": [
