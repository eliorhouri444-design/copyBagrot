{
  "name": "QuestionPattern",
  "type": "object",
  "properties": {
    "pattern_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d3\u05e4\u05d5\u05e1"
    },
    "subject": {
      "type": "string",
      "description": "\u05d4\u05de\u05e7\u05e6\u05d5\u05e2"
    },
    "topic": {
      "type": "string",
      "description": "\u05d4\u05e0\u05d5\u05e9\u05d0"
    },
    "pattern_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05d9\u05dc\u05d5\u05ea \u05de\u05e4\u05ea\u05d7 \u05dc\u05d6\u05d9\u05d4\u05d5\u05d9"
    },
    "question_structure": {
      "type": "string",
      "description": "\u05de\u05d1\u05e0\u05d4 \u05d4\u05e9\u05d0\u05dc\u05d4 \u05d4\u05db\u05dc\u05dc\u05d9"
    },
    "common_mistakes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "mistake": {
            "type": "string"
          },
          "correction": {
            "type": "string"
          }
        }
      },
      "description": "\u05d8\u05e2\u05d5\u05d9\u05d5\u05ea \u05e0\u05e4\u05d5\u05e6\u05d5\u05ea \u05d1\u05e1\u05d5\u05d2 \u05e9\u05d0\u05dc\u05d4 \u05d6\u05d4"
    },
    "solution_template": {
      "type": "string",
      "description": "\u05ea\u05d1\u05e0\u05d9\u05ea \u05e4\u05ea\u05e8\u05d5\u05df \u05db\u05dc\u05dc\u05d9\u05ea"
    },
    "diagram_requirements": {
      "type": "object",
      "description": "\u05d3\u05e8\u05d9\u05e9\u05d5\u05ea \u05dc\u05d0\u05d9\u05d5\u05e8",
      "properties": {
        "requires_diagram": {
          "type": "boolean"
        },
        "diagram_type": {
          "type": "string"
        },
        "key_elements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "example_questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e9\u05d0\u05dc\u05d5\u05ea \u05dc\u05d3\u05d5\u05d2\u05de\u05d4"
    },
    "priority": {
      "type": "number",
      "default": 0.5,
      "description": "\u05e2\u05d3\u05d9\u05e4\u05d5\u05ea \u05d1\u05d7\u05d9\u05e4\u05d5\u05e9 (0-1)"
    },
    "times_matched": {
      "type": "integer",
      "default": 0,
      "description": "\u05db\u05de\u05d4 \u05e4\u05e2\u05de\u05d9\u05dd \u05d4\u05d3\u05e4\u05d5\u05e1 \u05d6\u05d5\u05d4\u05d4"
    }
  },
  "required": [
    "pattern_name",
    "subject",
    "topic",
    "pattern_keywords"
  ],
  "rls": {
    "read": {},
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}