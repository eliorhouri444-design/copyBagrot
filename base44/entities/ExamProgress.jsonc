{
  "name": "ExamProgress",
  "type": "object",
  "properties": {
    "exam_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05d1\u05d7\u05df"
    },
    "exam_type": {
      "type": "string",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05de\u05d1\u05d7\u05df"
    },
    "subject": {
      "type": "string",
      "description": "\u05de\u05e7\u05e6\u05d5\u05e2"
    },
    "unit_level": {
      "type": "integer",
      "enum": [
        3,
        4,
        5
      ],
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea"
    },
    "current_section": {
      "type": "string",
      "description": "\u05d4\u05d7\u05dc\u05e7 \u05d4\u05e0\u05d5\u05db\u05d7\u05d9 \u05d1\u05de\u05d1\u05d7\u05df"
    },
    "current_question": {
      "type": "integer",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05e9\u05d0\u05dc\u05d4 \u05d4\u05e0\u05d5\u05db\u05d7\u05d9\u05ea"
    },
    "reading_answers": {
      "type": "object",
      "description": "\u05ea\u05e9\u05d5\u05d1\u05d5\u05ea \u05dc\u05d4\u05d1\u05e0\u05ea \u05e0\u05e7\u05e8\u05d0"
    },
    "writing_text": {
      "type": "string",
      "description": "\u05d8\u05e7\u05e1\u05d8 \u05d4\u05db\u05ea\u05d9\u05d1\u05d4"
    },
    "time_left": {
      "type": "integer",
      "description": "\u05d6\u05de\u05df \u05e9\u05e0\u05d5\u05ea\u05e8 \u05d1\u05e9\u05e0\u05d9\u05d5\u05ea"
    },
    "completed": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05d1\u05d7\u05df \u05d4\u05d5\u05e9\u05dc\u05dd"
    }
  },
  "required": [
    "exam_id",
    "exam_type",
    "subject",
    "unit_level"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}