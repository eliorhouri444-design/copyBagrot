{
  "name": "ModuleBExam",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05de\u05d1\u05d7\u05df"
    },
    "subject": {
      "type": "string",
      "description": "\u05de\u05e7\u05e6\u05d5\u05e2"
    },
    "unit_level": {
      "type": "integer",
      "enum": [
        3,
        4,
        5
      ],
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea"
    },
    "grammar_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_number": {
            "type": "integer"
          },
          "question_type": {
            "type": "string",
            "enum": [
              "multiple_choice",
              "fill_in_blank"
            ]
          },
          "question_text": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correct_answer": {
            "type": "string"
          },
          "points": {
            "type": "integer"
          }
        }
      },
      "description": "\u05e9\u05d0\u05dc\u05d5\u05ea \u05d3\u05e7\u05d3\u05d5\u05e7"
    },
    "writing_prompt": {
      "type": "string",
      "description": "\u05e0\u05d5\u05e9\u05d0 \u05d4\u05db\u05ea\u05d9\u05d1\u05d4"
    },
    "writing_min_words": {
      "type": "integer",
      "default": 35
    },
    "writing_max_words": {
      "type": "integer",
      "default": 40
    },
    "duration_minutes": {
      "type": "integer",
      "default": 30
    },
    "total_grammar_points": {
      "type": "integer",
      "default": 70
    },
    "total_writing_points": {
      "type": "integer",
      "default": 30
    },
    "passing_grade": {
      "type": "integer",
      "default": 56
    }
  },
  "required": [
    "title",
    "subject",
    "unit_level",
    "grammar_questions",
    "writing_prompt"
  ],
  "rls": {
    "read": {},
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}