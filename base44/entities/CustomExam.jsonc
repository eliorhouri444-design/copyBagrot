{
  "name": "CustomExam",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05de\u05d1\u05d7\u05df \u05d4\u05de\u05d5\u05ea\u05d0\u05dd \u05d0\u05d9\u05e9\u05d9\u05ea"
    },
    "subject": {
      "type": "string",
      "description": "\u05de\u05e7\u05e6\u05d5\u05e2"
    },
    "unit_level": {
      "type": "integer",
      "enum": [
        3,
        4,
        5
      ],
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_number": {
            "type": "integer"
          },
          "question_text": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correct_answer": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          }
        }
      },
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05e9\u05d0\u05dc\u05d5\u05ea"
    },
    "based_on_topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05d4\u05e0\u05d5\u05e9\u05d0\u05d9\u05dd \u05e9\u05d4\u05de\u05d1\u05d7\u05df \u05de\u05d1\u05d5\u05e1\u05e1 \u05e2\u05dc\u05d9\u05d4\u05dd"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05ea\u05d9 \u05d4\u05de\u05d1\u05d7\u05df \u05e0\u05d5\u05e6\u05e8"
    }
  },
  "required": [
    "title",
    "subject",
    "unit_level",
    "questions"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}