      "allowed_operations": [
        "read"
      ]
    }
  ],
  "whatsapp_greeting": "\ud83d\udc4b \u05e9\u05dc\u05d5\u05dd! \u05d0\u05e0\u05d9 \u05d4\u05de\u05d5\u05e8\u05d4 \u05d4\u05d7\u05db\u05dd. \u05e9\u05dc\u05d7 \u05e9\u05d0\u05dc\u05d4 \u05d5\u05d0\u05e2\u05d6\u05d5\u05e8 \u05dc\u05da \u05e2\u05dd \u05e4\u05ea\u05e8\u05d5\u05df \u05de\u05d3\u05d5\u05d9\u05e7!"
}